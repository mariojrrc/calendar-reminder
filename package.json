{
  "name": "calendar-reminder",
  "version": "1.0.0",
  "description": "Zero-backend desktop utility that watches Google, Outlook, and Mac Calendar and flies an airplane across the screen just before a meeting starts.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build:macos-calendar": "bash scripts/build-macos-calendar.sh",
    "ensure:electron-calendar": "bash scripts/ensure-electron-calendar-plist.sh",
    "prestart": "npm run build:macos-calendar && npm run ensure:electron-calendar",
    "predist": "npm run build:macos-calendar",
    "start": "electron .",
    "dist": "electron-builder --mac dmg --linux AppImage"
  },
  "dependencies": {
    "@azure/msal-node": "^5.4.3",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0"
  },
  "devDependencies": {
    "electron": "^43.8.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.calendarreminder.app",
    "productName": "Calendar Reminder",
    "files": [
      "main.js",
      "auth-google.js",
      "auth-outlook.js",
      "auth-macos.js",
      "config.html",
      "animation.html",
      "package.json",
      "!google_token.json",
      "!outlook_token.json",
      "!macos_calendar_enabled.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSCalendarsUsageDescription": "Calendar Reminder reads your calendars to alert you before meetings start.",
        "NSCalendarsFullAccessUsageDescription": "Calendar Reminder reads your calendars to alert you before meetings start."
      },
      "extraResources": [
        {
          "from": "native/macos-calendar/bin/macos-calendar-helper",
          "to": "macos-calendar-helper"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "overrides": {
    "gaxios": "^7.3.0"
  }
}
